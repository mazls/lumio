<Window x:Class="Lumio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumio"
        Icon="pack://application:,,,/Lumio;component/Assets/app.ico"
        WindowStyle="None"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}"
        Focusable="True"
        KeyDown="OnWindowKeyDown">

    <Grid x:Name="RootGrid">

        <!-- ==================== 1. LIVE VIEW & BACKGROUND LAYER ==================== -->
        <Image x:Name="LiveViewImageControl"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform x:Name="LiveViewScaleTransform" ScaleX="-1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>

        <!-- Subtle vignette / dark overlay to ensure readability -->
        <Border Background="{StaticResource TopFadeBrush}" Height="160" VerticalAlignment="Top" IsHitTestVisible="False" />
        <Border Background="{StaticResource BottomFadeBrush}" Height="200" VerticalAlignment="Bottom" IsHitTestVisible="False" />

        <!-- ==================== 2. REVIEW LAYER (CAPTURED PHOTO) ==================== -->
        <Grid x:Name="ReviewGrid" Visibility="Collapsed" Background="{StaticResource BackgroundBrush}">
            <Image x:Name="ReviewImageControl"
                   Stretch="Uniform"
                   Margin="40,60,40,140"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

            <!-- Bottom Review Actions Bar -->
            <Border VerticalAlignment="Bottom"
                    Background="{StaticResource GlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="0,1.5,0,0"
                    Padding="40,24">
                <Grid MaxWidth="1050">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Auto return countdown & Print Status -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="ReviewStatusTitleText" Text="FOTO GESPEICHERT!" Style="{StaticResource Eyebrow}" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock x:Name="ReviewTimerText" Text="Zurück in 12s" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="PrintStatusFeedbackText"
                                   Text=""
                                   FontSize="14"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentOrangeBrush}"
                                   Margin="0,4,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Print Button (Selphy direct print) -->
                    <Button x:Name="PrintButton"
                            Grid.Column="2"
                            Style="{StaticResource TouchGlassButton}"
                            Click="OnPrintPhotoClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️ " FontSize="22" VerticalAlignment="Center" />
                            <TextBlock x:Name="PrintButtonLabelText" Text="Drucken" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Done / Next Photo -->
                    <Button Grid.Column="4"
                            Content="Fertig / Nächstes Foto"
                            Style="{StaticResource TouchActionButton}"
                            Click="OnDoneReviewClick" />
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 3. IDLE / WELCOME OVERLAY ==================== -->
        <Grid x:Name="IdleOverlayGrid" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Glowing Event Title & Lumio Badge -->
                <Border Background="{StaticResource GlassBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="40"
                        Padding="16,10,28,10"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True" Margin="0,0,14,0"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF3D9A" BlurRadius="18" ShadowDepth="0" Opacity="0.7" />
                            </Border.Effect>
                            <Image Source="pack://application:,,,/Lumio;component/Assets/logo.png" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock x:Name="EventTitleText"
                                   Text="LUMIO"
                                   Style="{StaticResource Eyebrow}"
                                   FontSize="22"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentOrangeBrush}" />
                    </StackPanel>
                </Border>

                <!-- Template / Mode Selector Pills -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,28">
                    <Button x:Name="ModeSingleButton"
                            Content="📸 Einzelfoto"
                            Style="{StaticResource TouchGlassButton}"
                            Margin="0,0,10,0"
                            Padding="18,10"
                            Click="OnSelectModeSingleClick" />

                    <Button x:Name="ModeQuadButton"
                            Content="🖼️ 4er Collage"
                            Style="{StaticResource TouchGlassButton}"
                            Margin="0,0,10,0"
                            Padding="18,10"
                            Click="OnSelectModeQuadClick" />

                    <Button x:Name="ModeStripButton"
                            Content="🎞️ Doppelstreifen"
                            Style="{StaticResource TouchGlassButton}"
                            Margin="0,0,10,0"
                            Padding="18,10"
                            Click="OnSelectModeStripClick" />

                    <Button x:Name="ModeGifButton"
                            Content="🎬 GIF"
                            Style="{StaticResource TouchGlassButton}"
                            Margin="0,0,10,0"
                            Padding="18,10"
                            Click="OnSelectModeGifClick" />

                    <Button x:Name="ModeBoomerangButton"
                            Content="⚡ Boomerang"
                            Style="{StaticResource TouchGlassButton}"
                            Margin="0,0,10,0"
                            Padding="18,10"
                            Click="OnSelectModeBoomerangClick" />

                    <Button x:Name="ModeVideoButton"
                            Content="📹 Videobotschaft"
                            Style="{StaticResource TouchGlassButton}"
                            Padding="18,10"
                            Click="OnSelectModeVideoClick" />
                </StackPanel>

                <!-- Big Touch Callout Button -->
                <Button x:Name="StartCaptureButton"
                        Style="{StaticResource TouchActionButton}"
                        Height="110"
                        Padding="60,0"
                        Click="OnStartCaptureClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StartButtonIcon" Text="📸" FontSize="44" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock x:Name="StartButtonLabel" Text="FOTO STARTEN" FontSize="36" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock x:Name="StartSubtitleText"
                           Text="Tippe auf den Button, um den Countdown zu starten"
                           Style="{StaticResource Subtitle}"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0" />
            </StackPanel>
        </Grid>

        <!-- ==================== 4. COUNTDOWN OVERLAY ==================== -->
        <Grid x:Name="CountdownOverlayGrid" Visibility="Collapsed" IsHitTestVisible="False">
            <Border Background="#44000000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Multi-shot step indicator (e.g. "Foto 2 von 4") -->
                    <TextBlock x:Name="MultiShotStepText"
                               Text="Foto 1 von 4"
                               Style="{StaticResource Eyebrow}"
                               FontSize="24"
                               Foreground="{StaticResource AccentOrangeBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"
                               Visibility="Collapsed" />

                    <!-- Between-shots preview of last taken photo -->
                    <Border x:Name="SeriesPreviewBorder"
                            Width="520" Height="340"
                            CornerRadius="20"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="3"
                            Margin="0,0,0,16"
                            ClipToBounds="True"
                            Background="#111"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF3D9A" BlurRadius="40" ShadowDepth="0" Opacity="0.8" />
                        </Border.Effect>
                        <Image x:Name="SeriesPreviewImage" Stretch="UniformToFill" />
                    </Border>

                    <!-- Big Glowing Countdown Number -->
                    <Border x:Name="CountdownNumberBorder"
                            Width="260" Height="260"
                            CornerRadius="130"
                            Background="{StaticResource AccentGradientBrush}"
                            BorderBrush="#88FFFFFF"
                            BorderThickness="4">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF3D9A" BlurRadius="60" ShadowDepth="0" Opacity="0.9" />
                        </Border.Effect>
                        <TextBlock x:Name="CountdownNumberText"
                                   Text="3"
                                   Style="{StaticResource DisplayTitle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="CountdownStatusText"
                               Text="Bereit machen..."
                               Style="{StaticResource H2}"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 4b. VIDEO RECORDING OVERLAY ==================== -->
        <Grid x:Name="VideoRecordingOverlayGrid" Visibility="Collapsed" IsHitTestVisible="True">
            <!-- Top REC Badge and Timer -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                    Background="#CC0B0D13" BorderBrush="#88FF3D9A" BorderThickness="1.5"
                    CornerRadius="30" Padding="24,10,28,10">
                <Border.Effect>
                    <DropShadowEffect Color="#FF3366" BlurRadius="25" ShadowDepth="0" Opacity="0.8" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="RecBlinkDot" Width="18" Height="18" Fill="#FF3366" Margin="0,0,14,0" />
                    <TextBlock Text="REC" FontWeight="Black" FontSize="20" Foreground="#FF3366" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBlock x:Name="VideoTimerText" Text="00:00 / 00:20" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Bottom Control: Stop Recording Button -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,50">
                <Button x:Name="StopRecordingButton"
                        Style="{StaticResource TouchActionButton}"
                        Background="#E01F2937"
                        BorderBrush="#FF3366"
                        BorderThickness="2"
                        Height="90"
                        Padding="40,0"
                        Click="OnStopRecordingClick">
                    <Button.Effect>
                        <DropShadowEffect Color="#FF3366" BlurRadius="30" ShadowDepth="0" Opacity="0.7" />
                    </Button.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏹️" FontSize="36" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock Text="AUFNAHME BEENDEN" FontSize="26" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Tippe hier, wenn du fertig gesprochen hast"
                           Style="{StaticResource Subtitle}"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0" />
            </StackPanel>
        </Grid>

        <!-- ==================== 5. FLASH EFFECT ==================== -->
        <Border x:Name="FlashBorder" Background="White" Opacity="0" IsHitTestVisible="False" />

        <!-- ==================== 6. TOP BAR (CAMERA STATUS & ADMIN LOCK) ==================== -->
        <Grid VerticalAlignment="Top" Margin="28,24" Height="60">
            <!-- Camera & Mode Info (Left) with Brand Logo -->
            <Border HorizontalAlignment="Left"
                    Background="{StaticResource GlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="12,6,18,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="13" ClipToBounds="True" Margin="0,0,10,0"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                        <Image Source="pack://application:,,,/Lumio;component/Assets/logo.png" Stretch="UniformToFill" />
                    </Border>
                    <Ellipse x:Name="CameraStatusIndicator" Width="10" Height="10" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="CameraStatusText" Text="Kamera bereit" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Top Right Action Buttons: Info & Admin Lock -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Info & License Button -->
                <Button x:Name="AboutButton"
                        Style="{StaticResource CircularIconButton}"
                        ToolTip="Über Lumio &amp; Lizenz"
                        Margin="0,0,12,0"
                        Click="OnAboutClick">
                    <TextBlock Text="ℹ️" FontFamily="{StaticResource SymbolFont}" FontSize="18" />
                </Button>

                <!-- Admin Lock Button (PIN required) -->
                <Button Style="{StaticResource CircularIconButton}"
                        ToolTip="Admin-Bereich (PIN erforderlich)"
                        Click="OnAdminLockClick">
                    <TextBlock Text="🔒" FontFamily="{StaticResource SymbolFont}" FontSize="20" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 7. CORNER GALLERY THUMBNAIL (BOTTOM-LEFT) ==================== -->
        <Border x:Name="CornerGalleryBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="28,24"
                CornerRadius="18"
                Background="{StaticResource GlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1.5"
                Padding="8"
                Cursor="Hand"
                MouseLeftButtonUp="OnCornerGalleryClick"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="6" Opacity="0.8" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="76" Height="76" CornerRadius="12" ClipToBounds="True" Background="#222">
                    <Image x:Name="CornerThumbnailImage" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,16,0">
                    <TextBlock Text="GALERIE" Style="{StaticResource Eyebrow}" FontSize="12" Foreground="{StaticResource AccentOrangeBrush}" />
                    <TextBlock x:Name="GalleryCountText" Text="1 Foto" Style="{StaticResource Caption}" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Tippen zum Ansehen" Style="{StaticResource Caption}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== 8. FULLSCREEN EVENT GALLERY OVERLAY ==================== -->
        <Grid x:Name="GalleryOverlayGrid" Visibility="Collapsed" Background="#F4080811">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="32,24">
                <StackPanel>
                    <TextBlock Text="EVENT-GALERIE" Style="{StaticResource Eyebrow}" Foreground="{StaticResource AccentOrangeBrush}" />
                    <TextBlock x:Name="GalleryIndexTitleText" Text="Foto 1 von 10" Style="{StaticResource H2}" Margin="0,4,0,0" />
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource TouchGlassButton}"
                        Click="OnCloseGalleryClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✕" FontFamily="{StaticResource SymbolFont}" FontSize="18" Margin="0,0,8,0" />
                        <TextBlock Text="Zurück zur Booth" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Center: Main Image with Nav Buttons -->
            <Grid Grid.Row="1" Margin="20,0">
                <Image x:Name="GalleryMainImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="100,10" />

                <!-- Previous Button -->
                <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                        Width="64" Height="80"
                        Style="{StaticResource TouchGlassButton}"
                        Click="OnGalleryPrevClick">
                    <TextBlock Text="◀" FontFamily="{StaticResource SymbolFont}" FontSize="28" Foreground="White" />
                </Button>

                <!-- Next Button -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="64" Height="80"
                        Style="{StaticResource TouchGlassButton}"
                        Click="OnGalleryNextClick">
                    <TextBlock Text="▶" FontFamily="{StaticResource SymbolFont}" FontSize="28" Foreground="White" />
                </Button>
            </Grid>

            <!-- Footer: Print & Action Bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource GlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="0,1.5,0,0"
                    Padding="32,20">
                <Grid MaxWidth="1050">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="GalleryPhotoInfoText" Text="IMG_20261016_205500.jpg" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="GalleryPrintStatusText" Text="" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{StaticResource AccentOrangeBrush}" Visibility="Collapsed" />
                    </StackPanel>

                    <Button x:Name="GalleryPrintButton"
                            Grid.Column="1"
                            Style="{StaticResource TouchActionButton}"
                            Padding="36,12"
                            Click="OnGalleryPrintClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️ " FontSize="20" VerticalAlignment="Center" />
                            <TextBlock x:Name="GalleryPrintButtonLabel" Text="Foto drucken (Selphy)" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
