<Window x:Class="Lumio.App.Views.AdminDashboardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumio – Admin Dashboard"
        Width="820" Height="840"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="2"
            CornerRadius="24"
            Padding="24,22">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="50" ShadowDepth="12" Opacity="0.85" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Lumio Admin-Menü" Style="{StaticResource H2}" />
                    <TextBlock Text="Einstellungen anpassen, Hardware konfigurieren oder Kiosk verwalten" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource CircularIconButton}"
                        Width="44" Height="44"
                        Click="OnCloseClick">
                    <TextBlock Text="✕" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </Grid>

            <!-- Main Tab Control -->
            <TabControl x:Name="AdminTabControl" Grid.Row="1" Style="{StaticResource TouchTabControl}">

                <!-- TAB 1: ALLGEMEIN -->
                <TabItem Header="⚙️ Allgemein" Style="{StaticResource TouchTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0" Padding="0,0,6,0">
                        <StackPanel>

                            <!-- Quick Actions -->
                            <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="SCHNELLAKTIONEN" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Style="{StaticResource TouchGlassButton}" Click="OnOpenFolderClick">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📁 " FontSize="16" />
                                                <TextBlock Text="Fotos-Ordner" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Style="{StaticResource TouchGlassButton}" Click="OnAboutClick">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ℹ️ " FontSize="16" />
                                                <TextBlock Text="Über &amp; Lizenz" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="4" Style="{StaticResource TouchGlassButton}" BorderBrush="{StaticResource DangerBrush}" Click="OnExitAppClick">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🚪 " FontSize="16" />
                                                <TextBlock Text="Zum Desktop" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Event Name & Storage -->
                            <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="EVENT &amp; SPEICHERORT" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />

                                    <TextBlock Text="Event-Name (z.B. Hochzeit Marcel &amp; Julia)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="EventNameTextBox" Style="{StaticResource TouchTextBox}" Margin="0,0,0,12" GotFocus="OnInputGotFocus" />

                                    <TextBlock Text="Speicherordner für Originalfotos &amp; Videos" Style="{StaticResource FieldLabel}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="OutputFolderTextBox" Grid.Column="0" Style="{StaticResource TouchTextBox}" GotFocus="OnInputGotFocus" />
                                        <Button Grid.Column="2" Content="📁 Durchsuchen..." Style="{StaticResource TouchGlassButton}" Padding="14,8" Click="OnBrowseOutputFolderClick" />
                                    </Grid>

                                    <!-- USB Detection -->
                                    <StackPanel x:Name="UsbDrivesPanel">
                                        <TextBlock Text="Erkannte USB-Laufwerke / Wechseldatenträger:" Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="UsbDrivesComboBox" Grid.Column="0" Style="{StaticResource TouchComboBox}" />
                                            <Button x:Name="SelectUsbButton" Grid.Column="2" Content="Als Speicherort wählen" Style="{StaticResource TouchGlassButton}" Padding="14,8" Click="OnSelectUsbDriveClick" />
                                        </Grid>
                                        <TextBlock x:Name="UsbStatusText" Text="" Style="{StaticResource Caption}" Foreground="{StaticResource AccentOrangeBrush}" Margin="2,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Touch Keyboard & PIN -->
                            <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="16" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="TOUCH-BEDIENUNG &amp; SICHERHEIT" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />

                                    <CheckBox x:Name="OnScreenKeyboardCheckBox"
                                              Content="Bildschirmtastatur für Touch-Bedienung aktivieren"
                                              FontSize="16"
                                              Foreground="White"
                                              Margin="0,0,0,12"
                                              Click="OnKeyboardToggleClick" />

                                    <TextBlock Text="Admin-PIN ändern (4–8 Ziffern)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AdminPinTextBox" Style="{StaticResource TouchTextBox}" MaxLength="8" GotFocus="OnInputGotFocus" />
                                    <TextBlock Text="Schützt das Admin-Menü vor Gästen. Standard-PIN ist 1234." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: KAMERA -->
                <TabItem Header="📷 Kamera" Style="{StaticResource TouchTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0" Padding="0,0,6,0">
                        <StackPanel>

                            <!-- Camera Selection -->
                            <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="KAMERA-AUSWAHL" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />

                                    <TextBlock Text="Aktive Kamera für die Booth" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CameraSelectionComboBox" Style="{StaticResource TouchComboBox}" Margin="0,0,0,8" />

                                    <TextBlock x:Name="CameraDetectionStatusText"
                                               Text="Kameras werden erkannt..."
                                               Style="{StaticResource Caption}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,10" />

                                    <CheckBox x:Name="MirrorLiveViewCheckBox"
                                              Content="Live-Vorschau horizontal spiegeln (wie ein Spiegel)"
                                              FontSize="16"
                                              Foreground="White"
                                              Margin="0,0,0,14" />

                                    <!-- Test Photo Action -->
                                    <Border Background="#12121E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Testfoto aufnehmen (Vorschau)" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                                <TextBlock Text="Löst ein Testbild aus und zeigt die Vorschau an. Wird NICHT auf der Festplatte gespeichert."
                                                           Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button x:Name="TakeTestPhotoButton" Grid.Column="1"
                                                    Content="📸 Testfoto"
                                                    Style="{StaticResource TouchGlassButton}"
                                                    Padding="16,10"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Click="OnTakeTestPhotoClick" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- DSLR / Systemkamera Status & Driver -->
                            <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="DSLR / SYSTEMKAMERA (NIKON, CANON, SONY)" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                                    <TextBlock Text="Integrierte native USB-Tethering-Engine (wie in dslrBooth – läuft direkt in Lumio ohne jede Zusatzsoftware)." Style="{StaticResource Caption}" Margin="0,0,0,12" />

                                    <!-- Status Box -->
                                    <Border Background="#1A1A28" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DigiCamStatusIndicator" Grid.Column="0" Width="10" Height="10" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock x:Name="DigiCamStatusText" Grid.Column="1" Text="Kamera-Treiber bereit" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <Button Grid.Column="2" Content="🔄 Aktualisieren" Style="{StaticResource TouchGlassButton}" Padding="12,6" FontSize="13" Click="OnCheckDigiCamStatusClick" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- DSLR Manual Controls -->
                            <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="16" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="MANUELLE DSLR-BELICHTUNGSWERTE" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- ISO -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="ISO-Empfindlichkeit" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="CameraIsoComboBox" Style="{StaticResource TouchComboBox}" />
                                        </StackPanel>

                                        <!-- Shutter Speed -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Verschlusszeit" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="CameraShutterComboBox" Style="{StaticResource TouchComboBox}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Aperture -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Blende (f-Zahl)" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="CameraApertureComboBox" Style="{StaticResource TouchComboBox}" />
                                        </StackPanel>

                                        <!-- White Balance -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Weißabgleich" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="CameraWhiteBalanceComboBox" Style="{StaticResource TouchComboBox}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Exposure Compensation -->
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Belichtungskorrektur (Helligkeit)" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="CameraExposureCompComboBox" Style="{StaticResource TouchComboBox}" />
                                    </StackPanel>

                                    <TextBlock Text="💡 Empfehlung für Party/Blitz: ISO 200–400, 1/125s und Blende f/5.6." Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: AUFNAHME & LAYOUT -->
                <TabItem Header="🎬 Aufnahme" Style="{StaticResource TouchTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0" Padding="0,0,6,0">
                        <StackPanel>

                            <!-- Templates -->
                            <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="TEMPLATES &amp; FOTOSTREIFEN" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />

                                    <TextBlock Text="Standard-Template für Ausdrucke &amp; Collagen" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="TemplateSelectionComboBox" Style="{StaticResource TouchComboBox}" Margin="0,0,0,10" />

                                    <Button Style="{StaticResource TouchGlassButton}" HorizontalAlignment="Left" Click="OnOpenTemplatesFolderClick">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🎨 " FontSize="16" />
                                            <TextBlock Text="Templates-Ordner öffnen (eigene JSON-Vorlagen)" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Branding & Event Text -->
                            <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="FOTO-BRANDING &amp; EVENT-TEXT" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />

                                    <CheckBox x:Name="ShowLogoCheckBox" Content="Lumio-Logo in Foto-Ecke einblenden" FontSize="16" Foreground="White" Margin="0,0,0,8" />
                                    <TextBlock Text="Logo-Position" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="LogoPositionComboBox" Style="{StaticResource TouchComboBox}" Margin="0,0,0,12" />

                                    <CheckBox x:Name="ShowEventTextCheckBox" Content="Event-Text auf Fotos drucken / einblenden" FontSize="16" Foreground="White" Margin="0,0,0,8" />
                                    <TextBlock Text="Format des Event-Textes" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="EventTextFormatComboBox" Style="{StaticResource TouchComboBox}" Margin="0,0,0,6" />
                                    <TextBlock Text="💡 Vorschau: Mein Event – 2026" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Timing & Video Messages -->
                            <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="16" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="TIMING &amp; VIDEOBOTSCHAFTEN" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Countdown (Sekunden)" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="CountdownTextBox" Style="{StaticResource TouchTextBox}" GotFocus="OnInputGotFocus" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Vorschau-Dauer (Sekunden)" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ReviewTextBox" Style="{StaticResource TouchTextBox}" GotFocus="OnInputGotFocus" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Pause zwischen Serienfotos (Sekunden)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MultiShotPauseTextBox" Style="{StaticResource TouchTextBox}" Width="200" HorizontalAlignment="Left" GotFocus="OnInputGotFocus" />
                                    </StackPanel>

                                    <CheckBox x:Name="EnableVideoMessagesCheckBox"
                                              Content="Videobotschaften auf dem Startbildschirm aktivieren"
                                              FontSize="16"
                                              Foreground="White"
                                              Margin="0,0,0,8" />

                                    <StackPanel>
                                        <TextBlock Text="Max. Videobotschaft-Dauer (Sekunden)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="VideoDurationTextBox" Style="{StaticResource TouchTextBox}" Width="200" HorizontalAlignment="Left" GotFocus="OnInputGotFocus" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 4: DRUCKER -->
                <TabItem Header="🖨️ Drucker" Style="{StaticResource TouchTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0" Padding="0,0,6,0">
                        <StackPanel>

                            <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="16" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="DRUCKER &amp; CANON SELPHY" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />

                                    <TextBlock Text="Fotodrucker auswählen (Selphy CP1300 / CP1500 wird erkannt):" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="PrinterSelectionComboBox" Style="{StaticResource TouchComboBox}" Margin="0,0,0,14" />

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Style="{StaticResource TouchGlassButton}" Click="OnTestPrintClick">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🖨️ " FontSize="16" />
                                                <TextBlock Text="Testdruck senden" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <CheckBox Grid.Column="2"
                                                  x:Name="AutoPrintCheckBox"
                                                  Content="Auto-Druck nach Aufnahme"
                                                  FontSize="15"
                                                  Foreground="White"
                                                  VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Text="💡 Schließe den Canon Selphy per USB an oder richte ihn im Windows-Netzwerk ein." Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

            <!-- Touch On-Screen Keyboard Panel (Expandable) -->
            <Border x:Name="OnScreenKeyboardBorder"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Background="{StaticResource SurfaceElevatedBrush}"
                    BorderBrush="{StaticResource AccentOrangeBrush}"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="10,8"
                    Margin="0,10,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="⌨️ Bildschirmtastatur" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource TouchKeyButton}" Content="Schließen ▼" Width="90" Height="30" FontSize="11" Click="OnCloseKeyboardClick" />
                    </Grid>

                    <!-- Numbers Row -->
                    <UniformGrid Rows="1" Margin="0,1">
                        <Button Style="{StaticResource TouchKeyButton}" Content="1" Click="OnKeyClick" Tag="1" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="2" Click="OnKeyClick" Tag="2" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="3" Click="OnKeyClick" Tag="3" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="4" Click="OnKeyClick" Tag="4" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="5" Click="OnKeyClick" Tag="5" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="6" Click="OnKeyClick" Tag="6" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="7" Click="OnKeyClick" Tag="7" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="8" Click="OnKeyClick" Tag="8" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="9" Click="OnKeyClick" Tag="9" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="0" Click="OnKeyClick" Tag="0" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="⌫" Background="{StaticResource DangerBrush}" Click="OnBackspaceClick" />
                    </UniformGrid>

                    <!-- Letters Row 1 -->
                    <UniformGrid Rows="1" Margin="0,1">
                        <Button Style="{StaticResource TouchKeyButton}" Content="Q" Click="OnKeyClick" Tag="Q" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="W" Click="OnKeyClick" Tag="W" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="E" Click="OnKeyClick" Tag="E" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="R" Click="OnKeyClick" Tag="R" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="T" Click="OnKeyClick" Tag="T" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="Z" Click="OnKeyClick" Tag="Z" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="U" Click="OnKeyClick" Tag="U" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="I" Click="OnKeyClick" Tag="I" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="O" Click="OnKeyClick" Tag="O" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="P" Click="OnKeyClick" Tag="P" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="Ü" Click="OnKeyClick" Tag="Ü" />
                    </UniformGrid>

                    <!-- Letters Row 2 -->
                    <UniformGrid Rows="1" Margin="0,1">
                        <Button Style="{StaticResource TouchKeyButton}" Content="A" Click="OnKeyClick" Tag="A" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="S" Click="OnKeyClick" Tag="S" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="D" Click="OnKeyClick" Tag="D" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="F" Click="OnKeyClick" Tag="F" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="G" Click="OnKeyClick" Tag="G" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="H" Click="OnKeyClick" Tag="H" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="J" Click="OnKeyClick" Tag="J" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="K" Click="OnKeyClick" Tag="K" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="L" Click="OnKeyClick" Tag="L" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="Ö" Click="OnKeyClick" Tag="Ö" />
                        <Button Style="{StaticResource TouchKeyButton}" Content="Ä" Click="OnKeyClick" Tag="Ä" />
                    </UniformGrid>

                    <!-- Letters Row 3 & Space -->
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource TouchKeyButton}" Content="Y" Click="OnKeyClick" Tag="Y" />
                        <Button Grid.Column="1" Style="{StaticResource TouchKeyButton}" Content="X" Click="OnKeyClick" Tag="X" />
                        <Button Grid.Column="2" Style="{StaticResource TouchKeyButton}" Content="C" Click="OnKeyClick" Tag="C" />
                        <Button Grid.Column="3" Style="{StaticResource TouchKeyButton}" Content="V" Click="OnKeyClick" Tag="V" />
                        <Button Grid.Column="4" Style="{StaticResource TouchKeyButton}" Content="B" Click="OnKeyClick" Tag="B" />
                        <Button Grid.Column="5" Style="{StaticResource TouchKeyButton}" Content="N" Click="OnKeyClick" Tag="N" />
                        <Button Grid.Column="6" Style="{StaticResource TouchKeyButton}" Content="M" Click="OnKeyClick" Tag="M" />
                        <Button Grid.Column="7" Style="{StaticResource TouchKeyButton}" Content="LEERZEICHEN" Click="OnKeyClick" Tag=" " />
                        <Button Grid.Column="8" Style="{StaticResource TouchKeyButton}" Content="-" Click="OnKeyClick" Tag="-" />
                        <Button Grid.Column="9" Style="{StaticResource TouchKeyButton}" Content="." Click="OnKeyClick" Tag="." />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bottom Buttons: Save & Back -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Zurück zur Booth" Style="{StaticResource TouchGlassButton}" Click="OnCloseClick" />
                <Button Grid.Column="2" Content="Speichern &amp; Übernehmen" Style="{StaticResource TouchActionButton}" Click="OnSaveClick" />
            </Grid>

            <!-- Test Photo Preview Modal Overlay -->
            <Grid x:Name="TestPhotoOverlay" Grid.Row="0" Grid.RowSpan="4" Background="#F00A0A12" Visibility="Collapsed">
                <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" CornerRadius="20" Margin="24" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📸 Testfoto Vorschau" Style="{StaticResource H2}" FontSize="20" />
                                <TextBlock Text="Temporäre Vorschau zur Fokus- &amp; Belichtungsprüfung. Bild wird NICHT gespeichert."
                                           Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Style="{StaticResource CircularIconButton}"
                                    Width="36" Height="36"
                                    Click="OnCloseTestPhotoClick">
                                <TextBlock Text="✕" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Button>
                        </Grid>

                        <!-- Image Preview -->
                        <Border Grid.Row="1" Background="#0A0A12" CornerRadius="12" ClipToBounds="True">
                            <Image x:Name="TestPhotoImage" Stretch="Uniform" />
                        </Border>

                        <!-- Footer -->
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <TextBlock x:Name="TestPhotoStatusText" VerticalAlignment="Center" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Button HorizontalAlignment="Right" Content="Vorschau schließen" Style="{StaticResource TouchGlassButton}" Padding="20,10" Click="OnCloseTestPhotoClick" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
