<Window x:Class="Lumio.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über Lumio &amp; Lizenz"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="OnWindowKeyDown">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="2"
            CornerRadius="26"
            Padding="32,28">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="50" ShadowDepth="12" Opacity="0.85" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Close Button -->
            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource CircularIconButton}"
                    Width="40" Height="40"
                    Click="OnCloseClick">
                <TextBlock Text="✕" FontFamily="{StaticResource SymbolFont}" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" />
            </Button>

            <!-- Brand Header with Logo -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,20">
                <Border Width="96" Height="96"
                        CornerRadius="48"
                        ClipToBounds="True"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF3D9A" BlurRadius="25" ShadowDepth="0" Opacity="0.6" />
                    </Border.Effect>
                    <Image Source="pack://application:,,,/Lumio;component/Assets/logo_round.png" Stretch="Uniform" />
                </Border>

                <TextBlock Text="Lumio Photobooth"
                           Style="{StaticResource H1}"
                           FontSize="28"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="VersionText" Text="Version"
                           Style="{StaticResource Caption}"
                           Foreground="{StaticResource AccentOrangeBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Info & Origin Box -->
            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceElevatedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,14"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ÜBER DIESES PROJEKT" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                    <TextBlock Text="Moderne, hardwarenahe Fotobox-Software für Windows &amp; Microsoft Surface mit nativer Unterstützung für DSLR/DSLM-Kameras (Nikon, Canon, Sony, Fuji) und Canon Selphy CP1300 Fotodrucker."
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="🏠 Website:" Style="{StaticResource Caption}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Style="{StaticResource TouchGlassButton}"
                                Padding="12,6"
                                HorizontalAlignment="Right"
                                Click="OnOpenWebsiteClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="mazls.github.io/lumio" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="↗" FontFamily="{StaticResource SymbolFont}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="🌐 GitHub:" Style="{StaticResource Caption}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Style="{StaticResource TouchGlassButton}"
                                Padding="12,6"
                                HorizontalAlignment="Right"
                                Click="OnOpenGitHubClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="github.com/mazls/lumio" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="↗" FontFamily="{StaticResource SymbolFont}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- License Conditions Card -->
            <Border Grid.Row="2"
                    Background="{StaticResource GlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,16"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="LIZENZ- UND NUTZUNGSBEDINGUNGEN" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />

                    <!-- Permitted: Commercial Event Usage -->
                    <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✅" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Gewerbliche Event-Nutzung ERLAUBT" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="Du darfst diese Software uneingeschränkt auf privaten und gewerblichen Veranstaltungen einsetzen (Fotobox-Verleih, Hochzeiten, Firmenfeiern, Messen) und damit Einnahmen erzielen. Keine Lizenzgebühren, kein Abo!"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="18" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Restricted: Non-commercial Source Code -->
                    <Border Background="#1AEF4444" BorderBrush="#33EF4444" BorderThickness="1" CornerRadius="12" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="❌" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Quellcode: Kein Konkurrenzprodukt" FontWeight="Bold" FontSize="14" Foreground="{StaticResource DangerBrush}" />
                                <TextBlock Text="Den Quellcode darfst du lesen, anpassen und weitergeben. Nicht erlaubt ist, daraus eine konkurrierende Fotobox-Software zu machen und anzubieten oder zu verkaufen (PolyForm Shield License 1.0.0)."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="18" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Bottom Action: Close Button -->
            <Button Grid.Row="3"
                    Style="{StaticResource TouchActionButton}"
                    Height="52"
                    Padding="16,0"
                    Margin="0,8,0,0"
                    Click="OnCloseClick">
                <TextBlock Text="Alles klar / Schließen"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
            </Button>
        </Grid>
    </Border>
</Window>
