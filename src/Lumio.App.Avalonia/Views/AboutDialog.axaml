<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lumio.App.Avalonia.Views.AboutDialog"
        Title="Über Lumio &amp; Lizenz"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        KeyDown="OnWindowKeyDown">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="2"
            CornerRadius="24"
            Padding="28,24">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Close Button -->
            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="36" Height="36" CornerRadius="18"
                    Background="{StaticResource GlassBrush}"
                    Click="OnCloseClick">
                <TextBlock Text="✕" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>

            <!-- Brand Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,18" Spacing="6">
                <Border Width="84" Height="84"
                        CornerRadius="20"
                        ClipToBounds="True"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="2"
                        HorizontalAlignment="Center">
                    <Image Source="avares://Lumio/Assets/logo.png" Stretch="UniformToFill" />
                </Border>

                <TextBlock Text="Lumio Photobooth"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Version 1.1.0 • Raspberry Pi / Linux Edition"
                           FontSize="13"
                           Foreground="{StaticResource AccentOrangeBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Info & Origin Box -->
            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceElevatedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,12"
                    Margin="0,0,0,14">
                <StackPanel Spacing="6">
                    <TextBlock Text="ÜBER DIESES PROJEKT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}" />
                    <TextBlock Text="Moderne, hardwarenahe Fotobox-Software für Raspberry Pi &amp; Linux mit nativer Unterstützung für Nikon Kameras (D5600, Z 50 II) via gphoto2 und Canon Selphy CP1300 via CUPS."
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="🌐 GitHub: https://github.com/mazls/lumio" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- License Conditions Card -->
            <Border Grid.Row="2"
                    Background="{StaticResource GlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,14"
                    Margin="0,0,0,20">
                <StackPanel Spacing="10">
                    <TextBlock Text="LIZENZ- UND NUTZUNGSBEDINGUNGEN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}" />

                    <!-- Permitted: Commercial Event Usage -->
                    <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="✅ Gewerbliche Event-Nutzung ERLAUBT" FontWeight="Bold" FontSize="13" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="Freie Nutzung auf privaten und gewerblichen Events (Fotobox-Verleih, Hochzeiten, Firmenfeiern, Messen) inkl. Verkauf von Fotoabzügen. Keine Gebühren, kein Abo!"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Restricted: Non-commercial Source Code -->
                    <Border Background="#1AEF4444" BorderBrush="#33EF4444" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="❌ Quellcode: Nicht für kommerzielle Produkte" FontWeight="Bold" FontSize="13" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="Der Quellcode steht für private Zwecke, Lernen &amp; Beiträge bereit. Der Weiterverkauf des Quellcodes oder die Nutzung in kommerziellen Bezahl-Apps ist untersagt."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Close Action Button -->
            <Button Grid.Row="3"
                    Content="Alles klar / Schließen"
                    Background="{StaticResource AccentGradientBrush}"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="16"
                    CornerRadius="16"
                    Height="48"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="OnCloseClick" />
        </Grid>
    </Border>
</Window>
