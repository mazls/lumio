<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lumio.App.Avalonia.Views.AdminPinDialog"
        Title="Admin PIN"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        KeyDown="OnWindowKeyDown">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="2"
            CornerRadius="24"
            Padding="24,20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Close icon button -->
            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="36" Height="36" CornerRadius="18"
                    Background="{StaticResource GlassBrush}"
                    Click="OnCloseClick">
                <TextBlock Text="✕" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,5,0,16" Spacing="4">
                <TextBlock Text="Admin-Bereich" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="PIN eingeben zum Entsperren" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- PIN Display (Masked Dots) -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,16" Spacing="4">
                <TextBlock x:Name="PinDisplayText"
                           Text="••••"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorMessageText"
                           Text=""
                           FontSize="14"
                           Foreground="{StaticResource DangerBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Touch Keypad (3x4 Grid) -->
            <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>

                <!-- Row 1: 1, 2, 3 -->
                <Button Grid.Row="0" Grid.Column="0" Content="1" Margin="4" CornerRadius="14" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnDigitClick" Tag="1" />
                <Button Grid.Row="0" Grid.Column="1" Content="2" Margin="4" CornerRadius="14" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnDigitClick" Tag="2" />
                <Button Grid.Row="0" Grid.Column="2" Content="3" Margin="4" CornerRadius="14" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnDigitClick" Tag="3" />

                <!-- Row 2: 4, 5, 6 -->
                <Button Grid.Row="1" Grid.Column="0" Content="4" Margin="4" CornerRadius="14" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnDigitClick" Tag="4" />
                <Button Grid.Row="1" Grid.Column="1" Content="5" Margin="4" CornerRadius="14" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnDigitClick" Tag="5" />
                <Button Grid.Row="1" Grid.Column="2" Content="6" Margin="4" CornerRadius="14" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnDigitClick" Tag="6" />

                <!-- Row 3: 7, 8, 9 -->
                <Button Grid.Row="2" Grid.Column="0" Content="7" Margin="4" CornerRadius="14" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnDigitClick" Tag="7" />
                <Button Grid.Row="2" Grid.Column="1" Content="8" Margin="4" CornerRadius="14" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnDigitClick" Tag="8" />
                <Button Grid.Row="2" Grid.Column="2" Content="9" Margin="4" CornerRadius="14" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnDigitClick" Tag="9" />

                <!-- Row 4: Clear, 0, OK -->
                <Button Grid.Row="3" Grid.Column="0" Content="C" Margin="4" CornerRadius="14" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnClearClick" />
                <Button Grid.Row="3" Grid.Column="1" Content="0" Margin="4" CornerRadius="14" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnDigitClick" Tag="0" />
                <Button Grid.Row="3" Grid.Column="2" Content="✓" Margin="4" CornerRadius="14" FontSize="24" FontWeight="Bold" Background="{StaticResource SuccessBrush}" Foreground="White" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSubmitClick" />
            </Grid>

            <!-- Bottom Note -->
            <TextBlock Grid.Row="3"
                       Text="Standard-PIN: 1234 (im Dashboard änderbar)"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </Grid>
    </Border>
</Window>
