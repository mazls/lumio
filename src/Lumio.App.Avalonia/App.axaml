<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumio.App.Avalonia.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <!-- Design Tokens matching Lumio Dark-Glassmorphism Theme -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0B14" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161626" />
        <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#222238" />
        <SolidColorBrush x:Key="BorderBrush" Color="#33334D" />
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#44FFFFFF" />
        <SolidColorBrush x:Key="GlassBrush" Color="#331A1A2E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF3D9A" />
        <SolidColorBrush x:Key="AccentOrangeBrush" Color="#FF5E62" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />

        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FF5E62" Offset="0.0" />
            <GradientStop Color="#FF3D9A" Offset="1.0" />
        </LinearGradientBrush>
    </Application.Resources>
</Application>
