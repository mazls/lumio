<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumio.App.Avalonia.Views.MainView"
             Background="{StaticResource BackgroundBrush}"
             Focusable="True"
             KeyDown="OnControlKeyDown">

    <Grid x:Name="RootGrid">

        <!-- ==================== 1. LIVE VIEW & BACKGROUND LAYER ==================== -->
        <!-- Party backdrop: visible while the battery saver keeps the live view off and around the
             (letterboxed) live view in portrait -->
        <Image x:Name="IdleBackdropImage" Stretch="UniformToFill" IsHitTestVisible="False" />
        <!-- Every other bulb of the fairy lights; fading the two layers against each other makes them twinkle -->
        <Image x:Name="IdleBulbsAImage" Stretch="UniformToFill" IsHitTestVisible="False" />
        <Image x:Name="IdleBulbsBImage" Stretch="UniformToFill" IsHitTestVisible="False" />

        <Image x:Name="LiveViewImageControl"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               RenderTransformOrigin="50%,50%">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>

        <!-- Soft top and bottom fades keep the status bar and gallery thumbnail readable -->
        <Border Height="110" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#8C000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border Height="130" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="1" Color="#A6000000" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ==================== 2. REVIEW LAYER (CAPTURED PHOTO) ==================== -->
        <Grid x:Name="ReviewGrid" IsVisible="False" Background="{StaticResource BackgroundBrush}">
            <Image x:Name="ReviewImageControl"
                   Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   Margin="40,50,40,130"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

            <StackPanel VerticalAlignment="Bottom">
            <!-- Look selection: guests tap a filter, the saved and printed photo follows it -->
            <!-- No scrolling: one row in landscape, 2 x 3 on phones in portrait -->
            <Border x:Name="LookBar" IsVisible="False" HorizontalAlignment="Center" MaxWidth="760" Margin="12,0,12,10">
                <UniformGrid x:Name="LookButtonsPanel" Rows="1" />
            </Border>

            <!-- Bottom Review Actions Bar -->
            <Border x:Name="ReviewActionsBar"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource GlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="0,1.5,0,0"
                    Padding="36,20">
                <Grid x:Name="ReviewActionsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="ReviewStatusPanel" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="ReviewStatusTitleText" Text="FOTO GESPEICHERT!" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock x:Name="ReviewTimerText" Text="Zurück in 12s" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="PrintStatusFeedbackText" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentOrangeBrush}" IsVisible="False" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Print Button -->
                    <Button x:Name="PrintButton"
                            Grid.Column="2"
                            Background="{StaticResource SurfaceElevatedBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1.5"
                            CornerRadius="20"
                            Padding="24,12"
                            Click="OnPrintPhotoClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️ " FontSize="20" VerticalAlignment="Center" />
                            <TextBlock x:Name="PrintButtonLabelText" Text="Drucken" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Done / Next Photo Button -->
                    <Button x:Name="ReviewDoneButton"
                            Grid.Column="4"
                            Content="Fertig / Nächstes Foto"
                            Background="{StaticResource AccentGradientBrush}"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="18"
                            CornerRadius="20"
                            Padding="32,14"
                            Click="OnDoneReviewClick" />
                </Grid>
            </Border>
            </StackPanel>
        </Grid>

        <!-- ==================== 3. IDLE / WELCOME OVERLAY ==================== -->
        <Grid x:Name="IdleOverlayGrid" IsVisible="True">
            <!-- New release available: closable, comes back only for the next release -->
            <Border x:Name="UpdateBanner"
                    IsVisible="False"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    MaxWidth="560"
                    Margin="16,84,16,0"
                    Background="{StaticResource GlassBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="16,4,4,4">
                <!-- Emoji in its own normal-weight text: Android's emoji font has no bold glyphs -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="✨" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="UpdateBannerText" Grid.Column="1" Text="Neue Lumio-Version verfügbar" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Width="36" Height="36" CornerRadius="18" Margin="8,0,0,0" Background="Transparent"
                            ToolTip.Tip="Hinweis ausblenden" Click="OnDismissUpdateClick">
                        <TextBlock Text="✕" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <!-- Landscape: everything centered. Portrait: title and modes at the top, start button at the bottom,
                 so the (letterboxed) live view in the middle stays free - see ApplyOrientationLayout -->
            <Grid x:Name="IdleLayoutGrid" HorizontalAlignment="Center" VerticalAlignment="Center" RowDefinitions="Auto,20,Auto">
            <StackPanel x:Name="IdleTopPanel" Grid.Row="0" Spacing="20">

                <!-- Glowing Event Title with Logo Badge -->
                <Border Background="{StaticResource GlassBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="30"
                        Padding="16,8,28,8"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                        <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True">
                            <Image Source="avares://Lumio.App.Shared/Assets/logo_round.png" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="EventTitleText"
                                   TextTrimming="CharacterEllipsis"
                                   Text="LUMIO"
                                   FontSize="22"
                                   FontWeight="ExtraBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentOrangeBrush}" />
                    </StackPanel>
                </Border>

                <!-- Mode Selector Pills (one row in landscape, 2-column grid in portrait - see ApplyOrientationLayout) -->
                <Grid x:Name="ModeSelectorGrid" HorizontalAlignment="Center">
                    <Button x:Name="ModeSingleButton" Content="📸 Einzelfoto" CornerRadius="18" Padding="16,10" Margin="5" Click="OnSelectModeSingleClick" />
                    <Button x:Name="ModeQuadButton" Content="🖼️ 4er Collage" CornerRadius="18" Padding="16,10" Margin="5" Click="OnSelectModeQuadClick" />
                    <Button x:Name="ModeStripButton" Content="🎞️ Doppelstreifen" CornerRadius="18" Padding="16,10" Margin="5" Click="OnSelectModeStripClick" />
                    <Button x:Name="ModeGifButton" Content="🎬 GIF" CornerRadius="18" Padding="16,10" Margin="5" Click="OnSelectModeGifClick" />
                    <Button x:Name="ModeBoomerangButton" Content="⚡ Boomerang" CornerRadius="18" Padding="16,10" Margin="5" Click="OnSelectModeBoomerangClick" />
                    <Button x:Name="ModeVideoButton" Content="📹 Videobotschaft" CornerRadius="18" Padding="16,10" Margin="5" Click="OnSelectModeVideoClick" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="IdleBottomPanel" Grid.Row="2" Spacing="20">
                <!-- Big Touch Callout Button -->
                <Button x:Name="StartCaptureButton"
                        Background="{StaticResource AccentGradientBrush}"
                        Foreground="White"
                        Height="100"
                        CornerRadius="50"
                        Padding="50,0"
                        HorizontalAlignment="Center"
                        Click="OnStartCaptureClick">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock x:Name="StartButtonIcon" Text="📸" FontSize="40" VerticalAlignment="Center" />
                        <TextBlock x:Name="StartButtonLabel" Text="FOTO STARTEN" FontSize="32" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock x:Name="StartSubtitleText"
                           Text="Tippe auf den Button, um den Countdown zu starten"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="18"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
            </Grid>
        </Grid>

        <!-- ==================== 4. COUNTDOWN OVERLAY ==================== -->
        <Grid x:Name="CountdownOverlayGrid" IsVisible="False" IsHitTestVisible="False" Background="#55000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <!-- Multi-shot step indicator -->
                <TextBlock x:Name="MultiShotStepText"
                           Text="Foto 1 von 4"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentOrangeBrush}"
                           HorizontalAlignment="Center"
                           IsVisible="False" />

                <!-- Between-shots preview -->
                <Border x:Name="SeriesPreviewBorder"
                        Width="480" Height="320"
                        CornerRadius="16"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="3"
                        ClipToBounds="True"
                        Background="#111"
                        IsVisible="False">
                    <Image x:Name="SeriesPreviewImage" Stretch="UniformToFill" />
                </Border>

                <!-- Big Countdown Circle -->
                <Border Width="220" Height="220"
                        CornerRadius="110"
                        Background="{StaticResource AccentGradientBrush}"
                        BorderBrush="#88FFFFFF"
                        BorderThickness="3">
                    <TextBlock x:Name="CountdownNumberText"
                               Text="3"
                               FontSize="96"
                               FontWeight="ExtraBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="CountdownStatusText"
                           Text="Bereit machen..."
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ==================== 4b. VIDEO RECORDING OVERLAY ==================== -->
        <Grid x:Name="VideoRecordingOverlayGrid" IsVisible="False" IsHitTestVisible="True">
            <!-- Top REC Badge and Timer -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,35,0,0"
                    Background="#CC0B0D13" BorderBrush="#88FF3D9A" BorderThickness="1.5"
                    CornerRadius="25" Padding="20,8,24,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Ellipse x:Name="RecBlinkDot" Width="16" Height="16" Fill="#FF3366" VerticalAlignment="Center" />
                    <TextBlock Text="REC" FontWeight="Black" FontSize="18" Foreground="#FF3366" VerticalAlignment="Center" />
                    <TextBlock x:Name="VideoTimerText" Text="00:00 / 00:20" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Bottom Control: Stop Recording Button -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,45" Spacing="10">
                <Button x:Name="StopRecordingButton"
                        Background="#E01F2937"
                        BorderBrush="#FF3366"
                        BorderThickness="2"
                        Height="80"
                        CornerRadius="40"
                        Padding="36,0"
                        Click="OnStopRecordingClick">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="⏹️" FontSize="30" VerticalAlignment="Center" />
                        <TextBlock x:Name="StopRecordingLabel" Text="AUFNAHME BEENDEN" FontSize="24" FontWeight="ExtraBold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Tippe hier, wenn du fertig gesprochen hast"
                           FontSize="15"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ==================== 5. FLASH EFFECT ==================== -->
        <Border x:Name="FlashBorder" Background="White" Opacity="0" IsHitTestVisible="False" />

        <!-- ==================== 6. TOP BAR (CAMERA STATUS & BUTTONS) ==================== -->
        <Grid x:Name="TopBarGrid" VerticalAlignment="Top" Margin="24,20" Height="50">
            <!-- Camera & Mode Info (Left) -->
            <Border HorizontalAlignment="Left"
                    Background="{StaticResource GlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="10,6,16,6">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True">
                        <Image Source="avares://Lumio.App.Shared/Assets/logo_round.png" Stretch="Uniform" />
                    </Border>
                    <Ellipse x:Name="CameraStatusIndicator" Width="10" Height="10" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CameraStatusText" Text="Kamera bereit" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Top Right: Info & Admin Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <!-- Info Button -->
                <Button x:Name="AboutButton"
                        Width="44" Height="44"
                        CornerRadius="22"
                        Background="{StaticResource GlassBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        ToolTip.Tip="Über Lumio &amp; Lizenz"
                        Click="OnAboutClick">
                    <TextBlock Text="ℹ️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Admin Lock Button -->
                <Button Width="44" Height="44"
                        CornerRadius="22"
                        Background="{StaticResource GlassBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        ToolTip.Tip="Admin-Bereich (PIN erforderlich)"
                        Click="OnAdminLockClick">
                    <TextBlock Text="🔒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 7. CORNER GALLERY THUMBNAIL (BOTTOM-LEFT) ==================== -->
        <Border x:Name="CornerGalleryBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="24,20"
                CornerRadius="16"
                Background="{StaticResource GlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1.5"
                Padding="8"
                Cursor="Hand"
                PointerReleased="OnCornerGalleryClick"
                IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <Border Width="68" Height="68" CornerRadius="10" ClipToBounds="True" Background="#222">
                    <Image x:Name="CornerThumbnailImage" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GALERIE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}" />
                    <TextBlock x:Name="GalleryCountText" Text="1 Foto" FontSize="14" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Tippen zum Ansehen" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== 8. FULLSCREEN EVENT GALLERY OVERLAY ==================== -->
        <Grid x:Name="GalleryOverlayGrid" IsVisible="False" Background="#F4080811">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid x:Name="GalleryHeaderGrid" Grid.Row="0" Margin="28,20">
                <StackPanel>
                    <TextBlock Text="EVENT-GALERIE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}" />
                    <TextBlock x:Name="GalleryIndexTitleText" Text="Foto 1 von 10" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,2,0,0" />
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        CornerRadius="16" Padding="18,8"
                        Background="{StaticResource GlassBrush}"
                        Click="OnCloseGalleryClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="✕" FontSize="16" />
                        <TextBlock Text="Zurück zur Booth" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Main Image & Navigation -->
            <Grid Grid.Row="1" Margin="20,0">
                <Image x:Name="GalleryMainImage" Stretch="Uniform" Margin="80,10" />
                <!-- Native video player (Android) for video messages -->
                <ContentControl x:Name="GalleryVideoHost" IsVisible="False" Margin="80,10" />

                <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                        Width="60" Height="74" CornerRadius="16"
                        Background="{StaticResource GlassBrush}"
                        Click="OnGalleryPrevClick">
                    <TextBlock Text="◀" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="60" Height="74" CornerRadius="16"
                        Background="{StaticResource GlassBrush}"
                        Click="OnGalleryNextClick">
                    <TextBlock Text="▶" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Footer: Reprint -->
            <Border x:Name="GalleryFooterBorder"
                    Grid.Row="2"
                    Background="{StaticResource GlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="0,1.5,0,0"
                    Padding="28,16">
                <Grid x:Name="GalleryFooterGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Delete (PIN protected) -->
                    <Button x:Name="GalleryDeleteButton"
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            Background="{StaticResource SurfaceElevatedBrush}"
                            BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1.5"
                            CornerRadius="18"
                            Padding="18,12"
                            ToolTip.Tip="Löschen (PIN erforderlich)"
                            Click="OnGalleryDeleteClick">
                        <TextBlock Text="Löschen" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                    </Button>

                    <StackPanel x:Name="GalleryInfoPanel" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="GalleryPhotoInfoText" Text="" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="GalleryPrintStatusText" Text="" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentOrangeBrush}" IsVisible="False" />
                    </StackPanel>

                    <Button x:Name="GalleryPrintButton"
                            Grid.Column="2"
                            Background="{StaticResource AccentGradientBrush}"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="16"
                            CornerRadius="18"
                            Padding="28,12"
                            Click="OnGalleryPrintClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🖨️ " FontSize="18" FontWeight="Normal" />
                            <TextBlock x:Name="GalleryPrintButtonLabel" Text="Foto drucken" FontSize="16" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 9. MODAL IN-APP DIALOG OVERLAY ==================== -->
        <Grid x:Name="ModalOverlayGrid" IsVisible="False" Background="#CC000000">
            <!-- Scrolls dialogs that are taller than small (phone) screens -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="12"
                        CornerRadius="24">
                    <ContentControl x:Name="ModalOverlayContent" />
                </Border>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
