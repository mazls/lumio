<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumio.App.Avalonia.Views.AboutDialog"
             Width="560"
             Background="Transparent"
             Focusable="True"
             KeyDown="OnControlKeyDown">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="2"
            CornerRadius="24"
            Padding="28,24">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Close Button -->
            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="36" Height="36" CornerRadius="18"
                    Background="{StaticResource GlassBrush}"
                    Click="OnCloseClick">
                <TextBlock Text="✕" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>

            <!-- Brand Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,18" Spacing="6">
                <Border Width="84" Height="84"
                        CornerRadius="42"
                        ClipToBounds="True"
                        HorizontalAlignment="Center">
                    <Image Source="avares://Lumio.App.Shared/Assets/logo_round.png" Stretch="Uniform" />
                </Border>

                <TextBlock Text="Lumio Photobooth"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="VersionText" Text="Version"
                           FontSize="13"
                           Foreground="{StaticResource AccentOrangeBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Info & Origin Box -->
            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceElevatedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,12"
                    Margin="0,0,0,14">
                <StackPanel Spacing="6">
                    <TextBlock Text="ÜBER DIESES PROJEKT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}" />
                    <TextBlock x:Name="DescriptionText"
                               Text="Moderne, hardwarenahe Fotobox-Software für Raspberry Pi &amp; Linux mit nativer Unterstützung für DSLR/DSLM-Kameras (Nikon, Canon, Sony, Fuji via gphoto2) und Canon Selphy CP1300 via CUPS."
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <Grid ColumnDefinitions="*,8,*" Margin="0,6,0,0">
                        <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="10" Padding="10,8" Click="OnOpenWebsiteClick">
                            <TextBlock Text="Website ↗" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Button>
                        <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="10" Padding="10,8" Click="OnOpenGitHubClick">
                            <TextBlock Text="GitHub ↗" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- License Conditions Card -->
            <Border Grid.Row="2"
                    Background="{StaticResource GlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,14"
                    Margin="0,0,0,20">
                <StackPanel Spacing="10">
                    <TextBlock Text="LIZENZ- UND NUTZUNGSBEDINGUNGEN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}" />

                    <!-- Permitted: Commercial Event Usage -->
                    <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="✅ Gewerbliche Event-Nutzung ERLAUBT" FontWeight="Bold" FontSize="13" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="Freie Nutzung auf privaten und gewerblichen Events (Fotobox-Verleih, Hochzeiten, Firmenfeiern, Messen) inkl. Verkauf von Fotoabzügen. Keine Gebühren, kein Abo!"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Restricted: Non-commercial Source Code -->
                    <Border Background="#1AEF4444" BorderBrush="#33EF4444" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="❌ Quellcode: Kein Konkurrenzprodukt" FontWeight="Bold" FontSize="13" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="Den Quellcode darfst du lesen, anpassen und weitergeben. Nicht erlaubt ist, daraus eine konkurrierende Fotobox-Software zu machen und anzubieten oder zu verkaufen (PolyForm Shield License 1.0.0)."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Close Action Button -->
            <Button Grid.Row="3"
                    Content="Alles klar / Schließen"
                    Background="{StaticResource AccentGradientBrush}"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="16"
                    CornerRadius="16"
                    Height="48"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="OnCloseClick" />
        </Grid>
    </Border>
</UserControl>
