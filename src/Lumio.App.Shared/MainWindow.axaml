<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Lumio.App.Avalonia.Views"
        x:Class="Lumio.App.Avalonia.MainWindow"
        Title="Lumio"
        Icon="avares://Lumio.App.Shared/Assets/app.ico"
        WindowState="FullScreen"
        Background="{StaticResource BackgroundBrush}">

    <views:MainView x:Name="MainBoothView" />
</Window>
